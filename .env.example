# ─── Frontend ──────────────────────────────────────────────────────────────────
# Network: undeployed | preview | preprod
VITE_NETWORK=undeployed

# Deployed contract address (set after npm run setup)
VITE_CONTRACT_ADDRESS=

# Proof server URL
VITE_PROOF_SERVER_URL=http://127.0.0.1:6300

# ─── Backend (CLI / Deploy scripts) ────────────────────────────────────────────
# Override wallet seed for preprod/preview (leave empty to auto-generate)
MIDNIGHT_WALLET_SEED=

# Override network endpoints if needed
MIDNIGHT_INDEXER_URL=
MIDNIGHT_INDEXER_WS_URL=
MIDNIGHT_NODE_URL=
MIDNIGHT_PROOF_SERVER_URL=
MIDNIGHT_FAUCET_URL=

# Private state encryption password (use a strong value in production)
PRIVATE_STATE_PASSWORD=
